---
import Base from "../../layouts/Base.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import { projects } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project: p } = Astro.props;
const i = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(i + 1) % projects.length];
---

<Base title={p.title} description={p.summary}>
  <header class="page-head head">
    <div class="wrap">
      <p class="crumb"><a href="/projects">Projects</a></p>
      <h1>{p.title}</h1>
      <dl class="facts">
        <div><dt>Town</dt><dd>{p.town}</dd></div>
        <div><dt>Finished</dt><dd>{p.year}</dd></div>
        <div><dt>Length</dt><dd>{p.duration}</dd></div>
        <div><dt>Budget range</dt><dd>{p.budget}</dd></div>
      </dl>
    </div>
  </header>
  <section class="compare">
    <div class="wrap grid">
      <BeforeAfter project={p} />
      <div class="notes">
        <p class="lede">{p.summary}</p>
        <h2>Before</h2>
        <p>{p.before}</p>
        <h2>After</h2>
        <p>{p.after}</p>
        <p class="meta">Sample project written for this template.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap work">
      <div>
        <h2 class="h">What the job took</h2>
        <p class="dim">{p.work.length} items</p>
      </div>
      <ol>{p.work.map((w) => <li>{w}</li>)}</ol>
    </div>
    {
      p.quote && (
        <div class="wrap">
          <blockquote>
            <p>{p.quote.text}</p>
            <footer>{p.quote.name}</footer>
          </blockquote>
        </div>
      )
    }
    <div class="wrap next">
      <a class="btn btn-primary" href="/quote">Start a project like this</a>
      <a class="btn btn-line" href={`/projects/${next.slug}`}>Next project: {next.title}</a>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-bottom: 32px;
  }
  .crumb {
    color: var(--muted);
    margin-bottom: 16px;
  }
  .head h1 {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    max-width: 22ch;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 24px 0 0;
  }
  dt {
    color: var(--muted);
    font-size: 0.875rem;
  }
  dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .notes h2 {
    font-size: 1.375rem;
    font-weight: 500;
    margin: 24px 0 4px;
  }
  .notes p:not(.lede):not(.meta) {
    color: var(--ink-2);
  }
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(24px, 4vw, 56px);
  }
  .h {
    font-size: 2rem;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: w;
  }
  ol li {
    counter-increment: w;
    display: grid;
    grid-template-columns: 32px 1fr;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  ol li::before {
    content: counter(w);
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--muted);
  }
  blockquote {
    margin: 64px 0 0;
    padding: 32px 0 0;
    border-top: 1px solid var(--line-strong);
    max-width: 44rem;
  }
  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
  }
  blockquote footer {
    color: var(--muted);
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 64px;
  }
  @media (max-width: 860px) {
    .grid,
    .work {
      grid-template-columns: 1fr;
    }
  }
</style>
