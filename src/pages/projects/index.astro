---
import Base from "../../layouts/Base.astro";
import ProjectArt from "../../components/ProjectArt.astro";
import { projects } from "../../data/site";
---

<Base title="Projects" description="Recent remodels, additions and porches, with before and after views.">
  <header class="page-head dark">
    <div class="wrap">
      <h1>Projects</h1>
      <p class="dim">{projects.length} recent jobs</p>
      <p class="lede">A few recent jobs, each with a before and after view, the scope and what it took. Sample projects written for this template.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap grid">
      {
        projects.map((p) => (
          <a class="card" href={`/projects/${p.slug}`}>
            <div class="img"><ProjectArt kind={p.kind} state="after" label={`After: ${p.after}`} /></div>
            <div class="body">
              <h2>{p.title}</h2>
              <p>{p.summary}</p>
              <p class="meta">{p.town}, {p.year} &middot; {p.duration} &middot; {p.budget}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }
  .card {
    text-decoration: none;
    display: grid;
    align-content: start;
  }
  .img {
    aspect-ratio: 8 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .body {
    padding-top: 16px;
  }
  h2 {
    font-size: 1.75rem;
    margin-bottom: 8px;
  }
  .card:hover h2 {
    text-decoration: underline;
  }
  .body p:not(.meta) {
    color: var(--ink-2);
  }
  .meta {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
