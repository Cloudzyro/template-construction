---
// Illustrated before and after views for each project type. Replace with your
// own photos (same 8:5 shape) by swapping this component for Astro's <Image>.
interface Props {
  kind: "kitchen" | "bath" | "addition" | "porch";
  state: "before" | "after";
  label: string;
}
const { kind, state, label } = Astro.props;
const after = state === "after";
const wall = after ? "#ece7df" : "#cfc6b6";
const floor = after ? "#c9a77c" : "#8f7b62";
const dark = "#2a2f33";
---

<svg viewBox="0 0 800 500" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  {
    kind === "kitchen" && (
      <g>
        <rect width="800" height="500" fill={wall} />
        <rect y="400" width="800" height="100" fill={floor} />
        {after ? (
          <>
            <rect x="0" y="0" width="800" height="18" fill="#d9d2c6" />
            <rect x="60" y="110" width="200" height="140" fill="#dcc3a0" />
            <line x1="160" y1="110" x2="160" y2="250" stroke="#b99c76" />
            <rect x="300" y="70" width="200" height="170" fill="#cfe0e6" stroke="#f8f7f5" stroke-width="10" />
            <rect x="540" y="110" width="200" height="140" fill="#dcc3a0" />
            <line x1="640" y1="110" x2="640" y2="250" stroke="#b99c76" />
            <rect x="40" y="300" width="720" height="100" fill="#dcc3a0" />
            <rect x="40" y="290" width="720" height="12" fill="#f4f1ec" />
            <rect x="180" y="352" width="440" height="110" fill="#cfa877" />
            <rect x="168" y="340" width="464" height="14" fill="#f4f1ec" />
            <line x1="260" y1="0" x2="260" y2="200" stroke={dark} />
            <line x1="540" y1="0" x2="540" y2="200" stroke={dark} />
            <path d="M242 200 h36 l-6 18 h-24 z" fill={dark} />
            <path d="M522 200 h36 l-6 18 h-24 z" fill={dark} />
            <rect x="250" y="462" width="12" height="38" fill={dark} />
            <rect x="540" y="462" width="12" height="38" fill={dark} />
          </>
        ) : (
          <>
            <rect x="0" y="0" width="800" height="70" fill="#b8ad9b" />
            <rect x="40" y="70" width="300" height="130" fill="#5c4632" />
            <rect x="460" y="70" width="300" height="130" fill="#5c4632" />
            {[40, 115, 190, 265, 460, 535, 610, 685].map((x) => <rect x={x + 6} y="76" width="63" height="118" fill="none" stroke="#4a3828" stroke-width="3" />)}
            <rect x="360" y="110" width="80" height="90" fill="#b7c5c9" stroke="#e8e2d6" stroke-width="6" />
            <rect x="40" y="290" width="720" height="110" fill="#5c4632" />
            <rect x="40" y="280" width="720" height="12" fill="#a59980" />
            <rect x="0" y="0" width="30" height="400" fill="#bdb29f" />
            <rect x="770" y="0" width="30" height="400" fill="#bdb29f" />
          </>
        )}
      </g>
    )
  }
  {
    kind === "bath" && (
      <g>
        <rect width="800" height="500" fill={wall} />
        <rect y="420" width="800" height="80" fill={after ? "#d7d4cf" : "#b8b0a2"} />
        {after ? (
          <>
            {Array.from({ length: 10 }, (_, r) => <line x1="40" y1={40 + r * 38} x2="420" y2={40 + r * 38} stroke="#d8d1c6" />)}
            {Array.from({ length: 6 }, (_, c) => <line x1={40 + c * 76} y1="40" x2={40 + c * 76} y2="420" stroke="#d8d1c6" />)}
            <rect x="40" y="40" width="380" height="380" fill="none" stroke="#bfb6a8" />
            <rect x="420" y="40" width="6" height="380" fill="#a8b8bc" opacity="0.8" />
            <rect x="90" y="410" width="260" height="6" fill="#8c9499" />
            <circle cx="230" cy="96" r="22" fill="#8c9499" />
            <rect x="480" y="300" width="280" height="90" fill="#9a7b5a" />
            <rect x="472" y="290" width="296" height="12" fill="#f4f1ec" />
            <rect x="500" y="120" width="100" height="140" rx="50" fill="#dfe8ea" stroke="#8c9499" stroke-width="3" />
            <rect x="640" y="120" width="100" height="140" rx="50" fill="#dfe8ea" stroke="#8c9499" stroke-width="3" />
          </>
        ) : (
          <>
            <rect x="40" y="300" width="400" height="120" fill="#e8e4da" stroke="#a69c8b" stroke-width="3" />
            <rect x="40" y="80" width="400" height="220" fill="#e2ddd2" stroke="#a69c8b" stroke-width="3" />
            <line x1="420" y1="60" x2="420" y2="300" stroke="#9d9282" stroke-width="3" />
            <path d="M420 60 C380 140 400 220 360 300" stroke="#b9ad97" stroke-width="10" fill="none" />
            <rect x="540" y="300" width="160" height="120" fill="#7c6247" />
            <rect x="532" y="290" width="176" height="12" fill="#c9bfa9" />
            <rect x="560" y="130" width="120" height="120" fill="#c8d0d2" stroke="#8f8574" stroke-width="4" />
            <rect x="600" y="30" width="40" height="24" fill="#bdb29f" />
          </>
        )}
      </g>
    )
  }
  {
    kind === "addition" && (
      <g>
        <rect width="800" height="500" fill={after ? "#dfe6e9" : "#d6d9d8"} />
        <rect y="420" width="800" height="80" fill={after ? "#8fa07a" : "#7f8a6c"} />
        <path d="M120 200 L260 110 L400 200 Z" fill="#4a4f54" />
        <rect x="140" y="200" width="240" height="220" fill={after ? "#f1ede6" : "#dcd5c8"} />
        {Array.from({ length: 11 }, (_, i) => <line x1="140" y1={210 + i * 20} x2="380" y2={210 + i * 20} stroke={after ? "#d9d3c8" : "#c5bdae"} />)}
        <rect x="180" y="240" width="44" height="60" fill="#5a6870" />
        <rect x="296" y="240" width="44" height="60" fill="#5a6870" />
        <rect x="180" y="330" width="44" height="60" fill="#5a6870" />
        <rect x="290" y="340" width="40" height="80" fill="#6b4f3a" />
        {after ? (
          <>
            <path d="M380 230 L510 150 L640 230 Z" fill="#4a4f54" />
            <rect x="400" y="230" width="220" height="190" fill="#f1ede6" />
            {Array.from({ length: 9 }, (_, i) => <line x1="400" y1={240 + i * 20} x2="620" y2={240 + i * 20} stroke="#d9d3c8" />)}
            <rect x="430" y="262" width="60" height="56" fill="#5a6870" />
            <rect x="530" y="262" width="60" height="56" fill="#5a6870" />
            <rect x="430" y="344" width="160" height="60" fill="#5a6870" />
            <line x1="510" y1="344" x2="510" y2="404" stroke="#f1ede6" stroke-width="4" />
          </>
        ) : (
          <>
            <path d="M380 330 L470 346 L470 420 L380 420 Z" fill="#9b8f7c" />
            <line x1="380" y1="330" x2="470" y2="350" stroke="#6f6556" stroke-width="4" />
            <line x1="460" y1="350" x2="458" y2="420" stroke="#6f6556" stroke-width="4" />
          </>
        )}
      </g>
    )
  }
  {
    kind === "porch" && (
      <g>
        <rect width="800" height="500" fill={after ? "#e3e8e6" : "#e6e1d4"} />
        <rect x="0" y="80" width="300" height="340" fill="#cfc7b8" />
        {Array.from({ length: 16 }, (_, i) => <line x1="0" y1={90 + i * 20} x2="300" y2={90 + i * 20} stroke="#bdb4a3" />)}
        <rect y="420" width="800" height="80" fill="#8a9a74" />
        {after ? (
          <>
            <path d="M300 200 L540 90 L780 200 Z" fill="#4a4f54" />
            <path d="M330 200 L540 110 L750 200 Z" fill="#c79a6b" />
            <rect x="300" y="200" width="480" height="210" fill="#cfd8d8" opacity="0.55" />
            {[300, 420, 540, 660, 772].map((x) => <rect x={x} y="200" width="8" height="210" fill="#f1ede6" />)}
            <rect x="300" y="340" width="480" height="6" fill="#f1ede6" />
            <rect x="290" y="408" width="500" height="14" fill="#7d6a58" />
            <circle cx="540" cy="226" r="14" fill="none" stroke="#4a4f54" stroke-width="3" />
          </>
        ) : (
          <>
            <circle cx="680" cy="90" r="40" fill="#f0c98c" />
            <rect x="300" y="330" width="460" height="14" fill="#8c7458" />
            {[310, 400, 490, 580, 670, 750].map((x) => <rect x={x} y="344" width="8" height="76" fill="#7a6650" />)}
            {Array.from({ length: 23 }, (_, i) => <line x1={300 + i * 20} y1="270" x2={300 + i * 20} y2="330" stroke="#8c7458" stroke-width="3" />)}
            <rect x="300" y="262" width="460" height="8" fill="#8c7458" />
            <path d="M420 330 l30 8 l-30 2 z" fill="#5e4c3a" />
          </>
        )}
      </g>
    )
  }
</svg>

<style>
  svg {
    width: 100%;
    height: 100%;
  }
</style>
